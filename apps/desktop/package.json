{
  "name": "@tapout/desktop",
  "version": "0.0.2",
  "private": true,
  "description": "TAP / OUT desktop shell",
  "author": "TAP / OUT",
  "main": "main.cjs",
  "scripts": {
    "copy-renderer": "node scripts/copy-renderer.cjs",
    "start": "npm run copy-renderer && electron .",
    "package:win": "npm run copy-renderer && electron-builder --win --x64 --publish never"
  },
  "build": {
    "appId": "com.tapout.game",
    "productName": "TAP OUT",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "store.cjs",
      "renderer/**"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "TAP-OUT-${version}.exe"
    },
    "electronVersion": "44.7.0",
    "npmRebuild": false
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  }
}
