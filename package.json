{
  "name": "tap-out",
  "version": "3.0.0-ow.4",
  "private": true,
  "type": "module",
  "description": "TAP / OUT - a wilderness survival competition game for Windows.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @tapout/game",
    "build": "npm run build --workspace @tapout/game",
    "desktop": "npm run build && npm run start --workspace @tapout/desktop",
    "package:win": "npm run build && npm run package:win --workspace @tapout/desktop",
    "typecheck": "tsc -p packages/core && tsc -p packages/content && tsc -p packages/harness && tsc -p apps/game && tsc -p tests",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test",
    "legacy:index": "tsx packages/harness/src/tools/legacy-index.cli.ts",
    "legacy:run": "tsx packages/harness/src/tools/legacy-run.cli.ts",
    "parity": "tsx packages/harness/src/tools/parity.cli.ts",
    "balance": "tsx packages/harness/src/tools/balance.cli.ts",
    "home:rarity": "tsx packages/harness/src/tools/home-rarity.cli.ts",
    "soak": "tsx packages/harness/src/tools/soak.cli.ts",
    "builds": "tsx packages/harness/src/tools/builds.cli.ts",
    "table": "tsx packages/harness/src/tools/table.cli.ts",
    "voice:lines": "tsx packages/harness/src/tools/voice-lines.cli.ts",
    "icon": "node scripts/icon/make-icon.mjs",
    "cover": "node scripts/icon/make-cover.mjs",
    "notices": "node scripts/legal/notices.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
